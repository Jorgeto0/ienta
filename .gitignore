# ============================================================
# Ienta — .gitignore
# Files & directories git must never track.
# ============================================================

# ---- macOS metadata ----
# Finder generates these automatically. Useless cross-platform noise.
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- Build artifacts (firmware) ----
# All generated by the toolchain from source. Never commit; always rebuildable.
build/
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst
*.su

# ---- Editor / IDE state ----
# Personal to a developer's machine; should not be imposed on the team.
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Python (for ai/ and tools/ later) ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- Logs & temporary captures ----
# UART captures, debug dumps, scratch files.
*.log
*.tmp
scratch/

# ---- Secrets ----
# Never commit credentials. Even in private repos — habits matter.
.env
*.pem
*.key
